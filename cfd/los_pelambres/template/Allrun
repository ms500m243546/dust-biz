#!/bin/bash
# Phase BA.3 - run one regime (BCs already patched by the orchestrator).
# Produces postProcessing/cloudInfo/<time>/<receptor>.dat and
# the final time-step field directory used for source-receptor extraction.

# Source OpenFOAM env BEFORE enabling strict mode (the vendor bashrc
# has internal `[ ... ]` tests that abort under `set -e`).
: "${OPENFOAM_BASHRC:=/usr/lib/openfoam/openfoam2312/etc/bashrc}"
if [[ ! -f "$OPENFOAM_BASHRC" ]]; then
    echo "ERROR: OpenFOAM bashrc not found at $OPENFOAM_BASHRC" >&2
    exit 127
fi
# shellcheck disable=SC1090
source "$OPENFOAM_BASHRC"

set -e
set -o pipefail

cd "$(dirname "$0")"

if [[ ! -d constant/polyMesh ]]; then
    echo "ERROR: constant/polyMesh missing. Run Allmesh first." >&2
    exit 1
fi

NCORES=${NCORES:-12}

echo "[Allrun] decomposePar -force"
decomposePar -force > log.decomposePar 2>&1

echo "[Allrun] simpleFoam (parallel, ${NCORES} cores)"
mpirun -np "${NCORES}" simpleFoam -parallel > log.simpleFoam 2>&1

echo "[Allrun] reconstructPar -latestTime"
reconstructPar -latestTime > log.reconstructPar 2>&1

echo "[Allrun] done; postProcessing/ ready for extraction"
