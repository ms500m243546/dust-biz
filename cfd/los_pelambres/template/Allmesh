#!/bin/bash
# Phase BA.3 - generate the mesh once per case directory.
# Run BEFORE Allrun. Produces constant/polyMesh/.

# Source the OpenFOAM env BEFORE enabling strict mode. Both `-e` and
# `-u` are too strict around vendor scripts: `-e` aborts on the first
# `[ -z "$VAR" ]` test that returns non-zero (which OpenFOAM's bashrc
# uses freely), and `-u` aborts on any read of an unset var. Login
# shells (bash -lc) don't auto-source ~/.bashrc; the user's bashrc
# line for OpenFOAM is invisible to us. Override OPENFOAM_BASHRC in
# the environment for non-default install paths.
: "${OPENFOAM_BASHRC:=/usr/lib/openfoam/openfoam2312/etc/bashrc}"
if [[ ! -f "$OPENFOAM_BASHRC" ]]; then
    echo "ERROR: OpenFOAM bashrc not found at $OPENFOAM_BASHRC" >&2
    echo "Set OPENFOAM_BASHRC, or apt install openfoam2312-default." >&2
    exit 127
fi
# shellcheck disable=SC1090
source "$OPENFOAM_BASHRC"

# Now lock in the strict mode for the actual mesh commands.
set -e
set -o pipefail

cd "$(dirname "$0")"

if [[ ! -f constant/triSurface/terrain.stl ]]; then
    echo "ERROR: constant/triSurface/terrain.stl missing." >&2
    echo "Run scripts/cfd/dem_to_stl.py first." >&2
    exit 1
fi

echo "[Allmesh] blockMesh"
blockMesh > log.blockMesh 2>&1

echo "[Allmesh] surfaceFeatureExtract"
surfaceFeatureExtract > log.surfaceFeatureExtract 2>&1 || true

echo "[Allmesh] snappyHexMesh -overwrite"
snappyHexMesh -overwrite > log.snappyHexMesh 2>&1

echo "[Allmesh] checkMesh"
checkMesh > log.checkMesh 2>&1 || echo "checkMesh reported issues; review log.checkMesh"

echo "[Allmesh] done"
